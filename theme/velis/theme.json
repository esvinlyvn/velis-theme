{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "ink",
					"name": "Mực (chữ chính)",
					"color": "#1A1A1A"
				},
				{
					"slug": "body-muted",
					"name": "Chữ phụ",
					"color": "#5C5C5C"
				},
				{
					"slug": "canvas",
					"name": "Nền ngà",
					"color": "#FAF8F5"
				},
				{
					"slug": "surface",
					"name": "Trắng",
					"color": "#FFFFFF"
				},
				{
					"slug": "surface-sunken",
					"name": "Nền phụ",
					"color": "#F2EEE8"
				},
				{
					"slug": "surface-dark",
					"name": "Nền tối",
					"color": "#141414"
				},
				{
					"slug": "hairline",
					"name": "Đường kẻ",
					"color": "#E4DED5"
				},
				{
					"slug": "hairline-strong",
					"name": "Đường kẻ đậm",
					"color": "#C9C1B5"
				},
				{
					"slug": "velis-red",
					"name": "Đỏ Velis",
					"color": "#B8282E"
				},
				{
					"slug": "velis-red-hover",
					"name": "Đỏ Velis đậm",
					"color": "#9E1F26"
				},
				{
					"slug": "champagne",
					"name": "Champagne",
					"color": "#B08D57"
				},
				{
					"slug": "champagne-text",
					"name": "Champagne (chữ)",
					"color": "#8A6A3A"
				},
				{
					"slug": "on-dark",
					"name": "Chữ trên nền tối",
					"color": "#FFFFFF"
				},
				{
					"slug": "on-dark-muted",
					"name": "Chữ phụ trên nền tối",
					"color": "#B9B9B9"
				},
				{
					"slug": "success",
					"name": "Thành công",
					"color": "#2E6B3F"
				},
				{
					"slug": "warning",
					"name": "Cảnh báo",
					"color": "#8A5A00"
				},
				{
					"slug": "error",
					"name": "Lỗi",
					"color": "#B3261E"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": {
				"minViewportWidth": "375px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Playfair Display",
					"fontFamily": "Playfair Display, Playfair Fallback, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Playfair Display",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/playfair-display-600.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Be Vietnam Pro",
					"fontFamily": "Be Vietnam Pro, Be Vietnam Pro Fallback, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Be Vietnam Pro",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/be-vietnam-pro-400.woff2"
							]
						},
						{
							"fontFamily": "Be Vietnam Pro",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/be-vietnam-pro-600.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "caption",
					"name": "caption",
					"size": "14px",
					"fluid": false
				},
				{
					"slug": "body-sm",
					"name": "body-sm",
					"size": "16px",
					"fluid": false
				},
				{
					"slug": "body",
					"name": "body",
					"size": "18px",
					"fluid": {
						"min": "17px",
						"max": "18px"
					}
				},
				{
					"slug": "heading-4",
					"name": "h4",
					"size": "20px",
					"fluid": {
						"min": "18px",
						"max": "20px"
					}
				},
				{
					"slug": "heading-3",
					"name": "h3",
					"size": "24px",
					"fluid": {
						"min": "20px",
						"max": "24px"
					}
				},
				{
					"slug": "heading-2",
					"name": "h2",
					"size": "36px",
					"fluid": {
						"min": "26px",
						"max": "36px"
					}
				},
				{
					"slug": "heading-1",
					"name": "h1",
					"size": "48px",
					"fluid": {
						"min": "32px",
						"max": "48px"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "1",
					"name": "1",
					"size": "4px"
				},
				{
					"slug": "2",
					"name": "2",
					"size": "8px"
				},
				{
					"slug": "3",
					"name": "3",
					"size": "12px"
				},
				{
					"slug": "4",
					"name": "4",
					"size": "16px"
				},
				{
					"slug": "6",
					"name": "6",
					"size": "24px"
				},
				{
					"slug": "8",
					"name": "8",
					"size": "32px"
				},
				{
					"slug": "12",
					"name": "12",
					"size": "48px"
				},
				{
					"slug": "16",
					"name": "16",
					"size": "64px"
				},
				{
					"slug": "24",
					"name": "24",
					"size": "96px"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"custom": {
			"radius": {
				"none": "0px",
				"sm": "2px",
				"pill": "999px"
			},
			"shadow": {
				"card-hover": "0 8px 24px rgba(20, 20, 20, 0.08)",
				"sticky-cta": "0 -4px 16px rgba(20, 20, 20, 0.10)"
			},
			"motion": {
				"fast": "150ms",
				"base": "200ms",
				"reveal": "320ms",
				"reveal-distance": "14px",
				"image-zoom": 1.03,
				"easing": "cubic-bezier(0.2, 0.6, 0.2, 1)"
			},
			"section": {
				"desktop": "96px",
				"mobile": "64px"
			},
			"gutter": {
				"desktop": "24px",
				"mobile": "16px"
			}
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "card-hover",
					"name": "card-hover",
					"shadow": "0 8px 24px rgba(20, 20, 20, 0.08)"
				},
				{
					"slug": "sticky-cta",
					"name": "sticky-cta",
					"shadow": "0 -4px 16px rgba(20, 20, 20, 0.10)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--canvas)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--6)",
			"padding": {
				"left": "var(--wp--custom--gutter--mobile)",
				"right": "var(--wp--custom--gutter--mobile)"
			}
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--heading-1)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--heading-2)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--heading-3)",
					"fontWeight": "600",
					"lineHeight": "1.35"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--heading-4)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--velis-red)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--velis-red-hover)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--velis-red)",
					"text": "var(--wp--preset--color--on-dark)"
				},
				"border": {
					"radius": "2px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"fontSize": "16px",
					"lineHeight": "1.25"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "28px",
						"right": "28px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--velis-red-hover)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--ink)",
						"width": "2px",
						"style": "solid",
						"offset": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)"
				},
				"color": {
					"text": "var(--wp--preset--color--body-muted)"
				}
			}
		},
		"blocks": {
			"core/image": {
				"border": {
					"radius": "0px"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--hairline)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--champagne)",
						"width": "2px",
						"style": "solid"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-style-guide",
			"title": "Style guide Velis",
			"postTypes": [
				"page"
			]
		}
	]
}
