		"custom": {
			"radius": {
				"none": "0px",
				"sm": "2px",
				"pill": "999px"
			},
			"shadow": {
				"card-hover": "0 8px 24px rgba(20, 20, 20, 0.08)",
				"sticky-cta": "0 -4px 16px rgba(20, 20, 20, 0.10)"
			},
			"motion": {
				"fast": "150ms",
				"base": "200ms",
				"reveal": "320ms",
				"reveal-distance": "14px",
				"image-zoom": 1.03,
				"easing": "cubic-bezier(0.2, 0.6, 0.2, 1)"
			},
			"section": {
				"desktop": "96px",
				"tablet": "64px",
				"mobile": "48px"
			},
			"gutter": {
				"desktop": "24px",
				"mobile": "16px"
			}
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "card-hover",
					"name": "card-hover",
					"shadow": "0 8px 24px rgba(20, 20, 20, 0.08)"
				},
				{
					"slug": "sticky-cta",
					"name": "sticky-cta",
					"shadow": "0 -4px 16px rgba(20, 20, 20, 0.10)"
				}
			]
		}
