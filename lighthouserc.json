{
  "ci": {
    "collect": {
      "url": [
        "https://staging.velisrealty.vn/",
        "https://staging.velisrealty.vn/du-an/the-global-city/",
        "https://staging.velisrealty.vn/blog/the-global-city/lan-song-fb-do-bo-soho-the-global-city/",
        "https://staging.velisrealty.vn/du-an/"
      ],
      "numberOfRuns": 1,
      "puppeteerScript": "./tools/lhci-login.cjs",
      "puppeteerLaunchOptions": {
        "args": [
          "--no-sandbox",
          "--headless=new"
        ]
      },
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "formFactor": "mobile",
        "onlyCategories": [
          "performance",
          "accessibility",
          "seo",
          "best-practices"
        ],
        "skipAudits": [
          "is-crawlable"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./test-results/lhci"
    }
  }
}
